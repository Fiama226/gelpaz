# ==========================================================================
#  GELPAZ IMMO — Configuration Apache (PHP 8.1+)
# ==========================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Si le site est installé dans un sous-dossier, décommentez et adaptez :
    # RewriteBase /gelpaz/

    # Forcer HTTPS (décommentez une fois le certificat SSL installé)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Forcer « www. » ou non (au choix) — exemple sans www :
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Dossiers internes interdits
    RewriteRule ^(app|config|database|storage|templates|tools)(/|$) - [F,L]
    # Fichiers cachés interdits (sauf .well-known)
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    # Aucun script PHP exécutable dans les téléversements
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar)$ - [F,L]

    # Fichiers existants servis directement
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste passe par le contrôleur frontal
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Fichiers sensibles
<FilesMatch "\.(sqlite|sqlite3|db|log|md|sql|lock|example|dist|sh|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<Files "server.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Cache navigateur des fichiers statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

# Limites PHP recommandées (si autorisé par l'hébergeur)
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 64M
    php_value max_execution_time 120
</IfModule>
